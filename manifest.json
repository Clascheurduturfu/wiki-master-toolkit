{
  "content_scripts": [
    {
      "css": [
        "styles.css",
        "theme-tracker.css",
        "ui.css"
      ],
      "js": [
        "bootstrap.js"
      ],
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "js": [
        "bridge/core.js",
        "bridge/collection.js",
        "bridge/packs.js",
        "bridge/intercept.js",
        "bridge/marketplace.js",
        "bridge/prices.js",
        "page-bridge.js",
        "sync-model.js",
        "discard-model.js",
        "features/core.js",
        "features/settings.js",
        "features/image-resolver.js",
        "features/price-ui.js",
        "features/shared-prices.js",
        "features/price-loader.js",
        "features/file-sync.js",
        "features/card-extras.js",
        "features/pull-stats.js",
        "features/compact-mode.js",
        "features/trades.js",
        "features/modal-ui.js",
        "features/pack-verification.js",
        "features/packs.js",
        "features/ranking.js",
        "features/collection-bulk.js",
        "features/discard.js",
        "features/extra-tools.js",
        "features/activity.js",
        "features/workspace-ui.js",
        "features/theme-tracker.js",
        "features/app.js",
        "content.js"
      ]
    }
  ],
  "description": "Prix moyens, collection, paquets, enchères, succès et synchronisation locale pour WikiMasters. Fork indépendant de WikiMastersTools.",
  "host_permissions": [
    "https://www.wiki-masters.com/*",
    "https://www.wikidata.org/*",
    "https://query.wikidata.org/*",
    "https://fr.wikipedia.org/*"
  ],
  "manifest_version": 3,
  "name": "Wiki Master Toolkit",
  "short_name": "WM Toolkit",
  "permissions": [
    "clipboardWrite"
  ],
  "version": "1.0.1",
  "version_name": "1.0.1 RC1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
